# Default: auto-detect text files, normalise to LF in the repo.
# Windows checkouts will still see CRLF on disk if core.autocrlf=true,
# but the committed copy stays LF — so the warnings on `git add` go away.
* text=auto eol=lf

# --- Source / config (always text, always LF) ---
*.py       text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.toml     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# --- Windows-only files (keep CRLF) ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# --- Binary (never touch line endings, never diff as text) ---
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.7z     binary
*.pkl    binary
*.joblib binary
*.npz    binary
*.npy    binary
*.h5     binary
*.pt     binary
*.pth    binary
*.onnx   binary
*.mp4    binary
*.mov    binary
*.wav    binary
*.mp3    binary

# --- Jupyter notebooks: text, but don't show full diffs in PRs ---
*.ipynb text eol=lf

# --- Lock files: text but auto-merge can be risky; keep as-is ---
poetry.lock     text eol=lf -diff
package-lock.json text eol=lf -diff
